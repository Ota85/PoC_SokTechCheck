@page "/psd2/callback"
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>PSD2 Callback – Finspector PoC</PageTitle>

<div class="container mt-4" style="max-width:680px">
    @if (_processing)
    {
        <div class="alert alert-info">Processing authorization callback…</div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">
            <strong>Callback error:</strong> @_error
        </div>
        <a href="/psd2" class="btn btn-outline-secondary">← Back to PSD2 page</a>
    }
    else
    {
        <div class="alert alert-success">
            <strong>Authorization callback received.</strong>
            <div class="mt-3">
                <small class="text-muted">
                    This page is only a local landing page for the registered return URL. The provider's
                    published API contract does not define a callback token-exchange flow.
                </small>
            </div>
        </div>

        @if (_allParams.Any())
        {
            <div class="card mb-3">
                <div class="card-header"><strong>All callback parameters</strong></div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Parameter</th><th>Value</th></tr></thead>
                        <tbody>
                            @foreach (var kv in _allParams)
                            {
                                <tr>
                                    <td><code>@kv.Key</code></td>
                                    <td class="text-break"><code>@kv.Value</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <a href="/psd2" class="btn btn-primary">← Back to PSD2 page</a>
    }
</div>

@code {
    private bool _processing = true;
    private string? _error;
    private List<KeyValuePair<string, string>> _allParams = [];

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var uri = new Uri(Nav.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

            // Collect all query params for display
            _allParams = query.AllKeys
                .Where(k => k != null)
                .Select(k => new KeyValuePair<string, string>(k!, query[k] ?? ""))
                .ToList();

            // Check for error from the bank
            var errorParam = query["error"];
            if (!string.IsNullOrWhiteSpace(errorParam))
            {
                var desc = query["error_description"] ?? "";
                _error = string.IsNullOrWhiteSpace(desc) ? errorParam : $"{errorParam}: {desc}";
                _processing = false;
                InvokeAsync(StateHasChanged);
                return;
            }

        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _processing = false;
            InvokeAsync(StateHasChanged);
        }
    }
}
