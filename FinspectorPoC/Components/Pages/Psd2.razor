@page "/psd2"
@rendermode InteractiveServer
@using FinspectorPoC.Models
@using FinspectorPoC.Services
@inject LocalSettingsService SettingsService
@inject TokenService TokenSvc
@inject Psd2Service Psd2Svc

<PageTitle>PSD2 Sandbox – Finspector PoC</PageTitle>

<div class="alert alert-danger mb-3" role="alert">
    <strong>⚠️ LOCAL DEVELOPER POC ONLY</strong> — credentials and bearer tokens are stored locally in plain text.
    Do not deploy this application publicly or commit <code>appsettings.local.json</code>.
</div>

<div class="card mb-3"><div class="card-header"><strong>1. Sandbox configuration</strong></div><div class="card-body">
    <div class="row g-2">
        <div class="col-md-6"><label class="form-label">Base API URL</label><input class="form-control" @bind="_settings.BaseApiUrl" /></div>
        <div class="col-md-6"><label class="form-label">Token URL</label><input class="form-control" @bind="_settings.TokenUrl" /></div>
        <div class="col-md-4"><label class="form-label">Client ID</label><input class="form-control" @bind="_settings.ClientId" /></div>
        <div class="col-md-4"><label class="form-label">Client Secret</label><input class="form-control" type="password" @bind="_settings.ClientSecret" /></div>
        <div class="col-md-2"><label class="form-label">OAuth Scope</label><input class="form-control" @bind="_settings.OAuthScope" /></div>
        <div class="col-md-2"><label class="form-label">Country</label><input class="form-control" @bind="_settings.CountryCode" /></div>
        <div class="col-md-4"><label class="form-label">Client Code <small class="text-muted">(applicant UUID; generated when blank)</small></label><input class="form-control" @bind="_settings.ClientCode" /></div>
        <div class="col-md-8"><label class="form-label">Registered return URL <small class="text-muted">(the required <code>clientId</code> parameter is added automatically)</small></label><input class="form-control" @bind="_settings.Psd2CallbackUrl" /></div>
        <div class="col-md-4"><label class="form-label">Reference number</label><input class="form-control" @bind="_settings.Psd2ReferenceNumber" /></div>
        <div class="col-md-3"><label class="form-label">User IP</label><input class="form-control" @bind="_settings.Psd2UserIp" /></div>
        <div class="col-md-5"><label class="form-label">User-agent</label><input class="form-control" @bind="_settings.Psd2UserBrowserAgent" /></div>
        <div class="col-md-3"><label class="form-label">History days <small class="text-muted">(1-365)</small></label><input class="form-control" type="number" min="1" max="365" @bind="_settings.Psd2HistoryDays" /></div>
    </div>
    <button class="btn btn-primary mt-3" @onclick="SaveSettings">Save settings</button>
    @if (_saved) { <span class="text-success ms-2">Saved ✓</span> }
</div></div>

<div class="card mb-3"><div class="card-header"><strong>2. Provider token</strong></div><div class="card-body">
    <button class="btn btn-success" @onclick="GetToken" disabled="@_tokenBusy">@(_tokenBusy ? "Requesting…" : "Get new token")</button>
    <button class="btn btn-outline-secondary ms-2" @onclick="UseSavedToken" disabled="@(string.IsNullOrWhiteSpace(_settings.SavedToken))">Use saved token</button>
    @if (!string.IsNullOrWhiteSpace(_tokenError)) { <div class="alert alert-danger mt-2">@_tokenError</div> }
    @if (!string.IsNullOrWhiteSpace(_token)) { <div class="alert alert-success mt-2">Provider token is active until @_settings.TokenExpiry?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz").</div> }
</div></div>

<div class="card mb-3"><div class="card-header"><strong>3. PSD2 account access</strong></div><div class="card-body">
    <p class="text-muted small">Uses the public provider contract: ProviderList → AccountAuth → AccountList → AccountInfo. Each request is a bearer-authorized POST.</p>
    <button class="btn btn-primary" @onclick="LoadProviders" disabled="@_busy">Load providers</button>
    @if (_providers?.Any() == true)
    {
        <div class="mt-3"><label class="form-label">Provider</label><select class="form-select" @bind="_providerCode"><option value="">— select —</option>@foreach (var provider in _providers) { <option value="@provider.ProviderCode">@provider.Name (@provider.ProviderCode) @provider.CountryCode</option> }</select></div>
        <button class="btn btn-warning mt-3" @onclick="StartAuthorization" disabled="@(_busy || string.IsNullOrWhiteSpace(_providerCode))">Start bank authorization</button>
        <button class="btn btn-outline-primary mt-3 ms-2" @onclick="LoadAccounts" disabled="@(_busy || string.IsNullOrWhiteSpace(_providerCode))">Load accounts</button>
    }
    @if (!string.IsNullOrWhiteSpace(_authenticationUrl))
    {
        <div class="alert alert-info mt-3">The provider returned an authorization URL. Complete bank authorization, then return to this PoC.<br /><a class="btn btn-warning mt-2" href="@_authenticationUrl" target="_blank">Open bank authorization</a></div>
    }
    @if (_accounts?.Any() == true)
    {
        <div class="mt-3"><label class="form-label">Account (optional for account information)</label><select class="form-select" @bind="_accountId"><option value="">All/provider default</option>@foreach (var account in _accounts) { <option value="@account.Id">@(account.IbanCode ?? account.AccountNumber ?? account.Id) — @account.AccountName @account.Balance</option> }</select></div>
        <button class="btn btn-outline-primary mt-3" @onclick="LoadAccountInfo" disabled="@_busy">Load account information</button>
    }
    <button class="btn btn-outline-danger mt-3 ms-2" @onclick="RevokeAuthorization" disabled="@(_busy || string.IsNullOrWhiteSpace(_settings.ClientCode))">Revoke authorization</button>
</div></div>

@if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert alert-danger">@_error</div> }
@if (_status.HasValue)
{
    <div class="card mb-3"><div class="card-header"><strong>Latest provider response: @_responseLabel</strong><span class="badge @(IsSuccess ? "bg-success" : "bg-danger") ms-2">HTTP @_status</span></div><pre class="m-0 p-3 bg-light" style="max-width:100%;max-height:420px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word">@(string.IsNullOrWhiteSpace(_raw) ? "<empty response body>" : _raw)</pre></div>
}

@code {
    private AppSettings _settings = new();
    private string? _token;
    private string? _tokenError;
    private bool _tokenBusy;
    private bool _saved;
    private bool _busy;
    private string? _error;
    private List<Psd2Provider>? _providers;
    private List<Psd2Account>? _accounts;
    private string? _providerCode;
    private string? _accountId;
    private string? _authenticationUrl;
    private int? _status;
    private string? _raw;
    private string? _responseLabel;
    private bool IsSuccess => _status is >= 200 and < 300;

    protected override void OnInitialized() => _settings = SettingsService.Load();

    private void SaveSettings()
    {
        SettingsService.Save(_settings);
        _saved = true;
    }

    private async Task GetToken()
    {
        _tokenBusy = true; _tokenError = null;
        try { _token = await TokenSvc.RequestNewTokenAsync(_settings); }
        catch (Exception ex) { _tokenError = ex.Message; }
        finally { _tokenBusy = false; }
    }

    private void UseSavedToken()
    {
        if (_settings.TokenExpiry <= DateTimeOffset.UtcNow) { _tokenError = "The saved token has expired."; return; }
        _token = _settings.SavedToken;
        _tokenError = null;
    }

    private async Task LoadProviders()
    {
        await Execute(async token =>
        {
            var result = await Psd2Svc.GetProvidersAsync(_settings, token);
            Show("ProviderList", result.Item1, result.Item2);
            _providers = result.Item3?.Providers;
        });
    }

    private async Task StartAuthorization()
    {
        if (!ValidateAuthorizationSettings()) return;
        await Execute(async token =>
        {
            var result = await Psd2Svc.StartAuthorizationAsync(_settings, token, _providerCode!);
            Show("AccountAuth", result.Item1, result.Item2);
            _authenticationUrl = result.Item3?.AuthenticationUrl;
        });
    }

    private async Task LoadAccounts()
    {
        if (!EnsureClientCode()) return;
        await Execute(async token =>
        {
            var result = await Psd2Svc.GetAccountsAsync(_settings, token, _providerCode!);
            Show("AccountList", result.Item1, result.Item2);
            _accounts = result.Item3?.Accounts;
        });
    }

    private async Task LoadAccountInfo()
    {
        if (!EnsureClientCode()) return;
        if (_settings.Psd2HistoryDays is < 1 or > 365)
        {
            _error = "History days must be between 1 and 365.";
            return;
        }
        await Execute(async token =>
        {
            var result = await Psd2Svc.GetAccountInfoAsync(_settings, token, _providerCode!, _accountId);
            Show("AccountInfo", result.Item1, result.Item2);
        });
    }

    private async Task RevokeAuthorization()
    {
        if (!EnsureClientCode()) return;
        await Execute(async token =>
        {
            var result = await Psd2Svc.RevokeAuthorizationAsync(_settings, token);
            Show("RevokeAuth", result.Item1, result.Item2);
        });
    }

    private async Task Execute(Func<string, Task> action)
    {
        _busy = true; _error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_token) || _settings.TokenExpiry <= DateTimeOffset.UtcNow)
                _token = await TokenSvc.GetValidTokenAsync(_settings, forceNew: false);
            await action(_token!);
            if (!IsSuccess)
                _error = string.IsNullOrWhiteSpace(_raw)
                    ? $"HTTP {_status}; the provider returned an empty response body."
                    : $"HTTP {_status}; inspect the provider response below.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void Show(string label, int status, string raw)
    {
        _responseLabel = label;
        _status = status;
        _raw = raw;
    }

    private bool ValidateAuthorizationSettings()
    {
        if (!EnsureClientCode()) return false;
        if (!Uri.TryCreate(_settings.Psd2CallbackUrl, UriKind.Absolute, out _))
        {
            _error = "Registered return URL must be an absolute URL registered with SokordiaTech.";
            return false;
        }
        if (string.IsNullOrWhiteSpace(_settings.Psd2ReferenceNumber)
            || string.IsNullOrWhiteSpace(_settings.Psd2UserBrowserAgent))
        {
            _error = "Reference number and the applicant's browser user-agent are required for bank authorization.";
            return false;
        }
        if (!System.Net.IPAddress.TryParse(_settings.Psd2UserIp, out var address)
            || address.AddressFamily != System.Net.Sockets.AddressFamily.InterNetwork
            || System.Net.IPAddress.IsLoopback(address))
        {
            _error = "User IP must be the applicant's non-loopback IPv4 address; do not use 127.0.0.1.";
            return false;
        }
        return true;
    }

    private bool EnsureClientCode()
    {
        if (string.IsNullOrWhiteSpace(_settings.ClientCode))
        {
            _settings.ClientCode = Guid.NewGuid().ToString();
            SettingsService.Save(_settings);
            return true;
        }

        if (Guid.TryParse(_settings.ClientCode, out _)) return true;

        _error = "PSD2 Client Code must be a UUID identifying the applicant. Clear the field to generate one for this PoC test.";
        return false;
    }
}
